# Supabase — copy to .env.local and fill from your project's API settings
# (Supabase dashboard -> Project Settings -> API). The publishable key is public-safe;
# RLS enforces data isolation, so it is fine to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Service-role key for the server-ONLY admin client (src/shared/db/admin.ts, D-17).
# Bypasses RLS + grants auth.admin.* — server-only; NEVER NEXT_PUBLIC.
# Local value: run `supabase status` (the "Secret" key). Cloud: dashboard -> API.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
